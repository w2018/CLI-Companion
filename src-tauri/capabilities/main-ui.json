{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "main-ui",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-set-title",
    "core:event:default",
    "core:app:default",
    "core:tray:default",
    "core:menu:default",
    "opener:default",
    "autostart:default",
    "dialog:default",
    "core:window:allow-destroy"
  ]
}
